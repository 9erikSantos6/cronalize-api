generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(dbgenerated("uuidv4()")) @db.Uuid
  email           String           @unique @db.VarChar(100)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiTokens       ApiToken[]
  appointments    Appointment[]
  refreshTokens   RefreshToken[]
  userPermissions UserPermission[]
  profile         UserProfile?
  webhooks        Webhook[]

  @@map("users")
}

model UserProfile {
  userId    String   @id @map("user_id") @db.Uuid
  userName  String   @unique @map("user_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Webhook {
  id                  String               @id @default(dbgenerated("uuidv4()")) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  address             String
  secretHash          String               @map("secret_hash") @db.VarChar(255)
  verified            Boolean              @default(false)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointmentWebhooks AppointmentWebhook[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model Appointment {
  id                  String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  description         String?
  tz                  String?               @db.VarChar(50)
  proceedingIn        DateTime?             @map("proceeding_in") @db.Timestamptz(6)
  scheduledFor        DateTime              @map("scheduled_for") @db.Timestamptz(6)
  payload             Json
  status              AppointmentStatusEnum @default(SCHEDULED)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointmentWebhooks AppointmentWebhook[]
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model AppointmentWebhook {
  appointmentId String      @map("appointment_id") @db.Uuid
  webhookId     String      @map("webhook_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  webhook       Webhook     @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@id([appointmentId, webhookId])
  @@map("appointment_webhooks")
}

model SystemPermission {
  id                  String               @id @default(dbgenerated("uuidv4()")) @db.Uuid
  permission          String               @unique @db.VarChar(50)
  description         String?
  role                String               @db.VarChar(25)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiTokenPermissions ApiTokenPermission[]
  userPermissions     UserPermission[]

  @@map("system_permissions")
}

model UserPermission {
  userId             String           @map("user_id") @db.Uuid
  systemPermissionId String           @map("system_permission_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  systemPermission   SystemPermission @relation(fields: [systemPermissionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, systemPermissionId])
  @@map("user_permissions")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("uuidv4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(100)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ApiToken {
  id                  String               @id @default(dbgenerated("uuidv4()")) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  name                String               @db.VarChar(60)
  description         String?
  tokenHash           String               @db.VarChar(255)
  isRevoked           Boolean              @default(false) @map("is_revoked")
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiTokenPermissions ApiTokenPermission[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model ApiTokenPermission {
  apiTokenId         String           @map("api_token_id") @db.Uuid
  systemPermissionId String           @map("system_permission_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiToken           ApiToken         @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)
  systemPermission   SystemPermission @relation(fields: [systemPermissionId], references: [id], onDelete: Cascade)

  @@id([apiTokenId, systemPermissionId])
  @@map("api_token_permissions")
}

enum AppointmentStatusEnum {
  SCHEDULED
  CANCELED
  EXECUTED
  FAILED
}
